# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# --- Model provider ---------------------------------------------------
# fake = deterministic offline stand-in (tests, make demo)
# anthropic = direct Anthropic API (local development, guide §07)
# bedrock = Amazon Bedrock via IAM role (in-cluster, guide §08-09)
FC_LLM_PROVIDER=fake

# Only used when FC_LLM_PROVIDER=anthropic. Local use only — never deployed.
FC_ANTHROPIC_API_KEY=
FC_ANTHROPIC_MODEL=

# Only used when FC_LLM_PROVIDER=bedrock.
FC_BEDROCK_MODEL_ID=
FC_AWS_REGION=us-east-1

# --- Database -----------------------------------------------------------
FC_DATABASE_URL=sqlite:///./data/forecaster.db
# In AWS, FC_DB_SECRET_ARN replaces FC_DATABASE_URL (password fetched from
# Secrets Manager at process start); FC_DB_HOST/FC_DB_NAME/FC_DB_PORT point
# at the RDS instance. Leave these blank for local development.
FC_DB_SECRET_ARN=
FC_DB_HOST=
FC_DB_NAME=forecaster
FC_DB_PORT=5432

# --- Pipeline behavior ----------------------------------------------------
FC_SAMPLES=5
FC_TEMPERATURE=0.7
FC_MAX_ARTICLES=8
FC_LOOKBACK_DAYS=14
FC_MAX_QUESTIONS=25
FC_MIN_BETTORS=10

# --- Publishing -----------------------------------------------------------
FC_TRACK_RECORD_DIR=./public
# If set, snapshots are also uploaded to this S3 bucket (guide §08-09).
FC_TRACK_RECORD_BUCKET=
FC_CALIBRATOR_PATH=./models/calibrator.json

# --- API ------------------------------------------------------------------
FC_ENABLE_DOCS=false
